end
gen_files["ssh-tunnel.sh"] = <<~'TUNSH'
  #!/bin/bash
  # Managed by VMs-Labs/Vagrantfile
  # Generic tunnel client - all topology comes from the Environment= lines in
  # ssh-tunnel.service, so one copy of this script serves every peer node.
  #   127.0.0.1:$TUNNEL_PORT (this node)  --ssh -L-->  $TARGET_IP:$TARGET_PORT (primary)
  set -u

  TARGET_IP="${TARGET_IP:?TARGET_IP is not set}"
  LAB_USER="${LAB_USER:-Mouhcine}"
  TUNNEL_PORT="${TUNNEL_PORT:-18080}"
  TARGET_PORT="${TARGET_PORT:-8080}"
  KEY="/home/$LAB_USER/.ssh/tunnel_ed25519"
  KNOWN="/home/$LAB_USER/.ssh/known_hosts"

  SSH_OPTS="-N -T
    -o ExitOnForwardFailure=yes
    -o ServerAliveInterval=15
    -o ServerAliveCountMax=3
    -o StrictHostKeyChecking=accept-new
    -o IdentitiesOnly=yes
    -o ConnectTimeout=10
    -o LogLevel=ERROR"

  if [ ! -r "$KEY" ]; then
    echo "[ssh-tunnel] cannot read $KEY" >&2
    exit 1
  fi

  # Re-pin the host key on EVERY attempt, not once at startup.
  # A rebuilt primary comes back with a new SSH host key, and
  # StrictHostKeyChecking=accept-new refuses a *changed* key outright (it only
  # tolerates an unknown one). Pinning once meant the tunnel never recovered
  # from a primary rebuild without a manual "systemctl restart ssh-tunnel" on
  # every peer. This runs only while disconnected - the loop blocks in "wait"
  # while the link is up - so it costs one keyscan per reconnect attempt.
  # Trade-off: re-pinning on reconnect gives up perfect host-key pinning. On an
  # isolated host-only segment with no untrusted parties that is the right
  # trade; on a routable network, pin once and restart the unit instead.
  repin() {
    ssh-keygen -R "$TARGET_IP" -f "$KNOWN" >/dev/null 2>&1
    ssh-keyscan -T 5 -H "$TARGET_IP" >> "$KNOWN" 2>/dev/null
  }

  repin
  while true; do
    if command -v autossh >/dev/null 2>&1; then
      autossh -M 0 $SSH_OPTS -i "$KEY" \
        -L 127.0.0.1:$TUNNEL_PORT:$TARGET_IP:$TARGET_PORT "$LAB_USER@$TARGET_IP" &
    else
      ssh $SSH_OPTS -i "$KEY" \
        -L 127.0.0.1:$TUNNEL_PORT:$TARGET_IP:$TARGET_PORT "$LAB_USER@$TARGET_IP" &
    fi
    wait $!
    echo "[ssh-tunnel] link to $TARGET_IP dropped, reconnecting in 3s..." >&2
    sleep 3
    repin
  done
TUNSH

# One unit per peer, carrying that peer's own forward port.
PEERS.each do |peer|
  gen_files["ssh-tunnel-#{peer[:name]}.service"] = <<~UNIT2
    [Unit]
    Description=SSH local-forward tunnel to #{PRIMARY[:name]} from #{peer[:name]} (Vagrant-managed)
    After=network-online.target
    Wants=network-online.target

    [Service]
    Type=simple
    User=#{NEW_USER}
    Group=#{NEW_USER}
    Environment=HOME=/home/#{NEW_USER}
    Environment=LAB_USER=#{NEW_USER}
    Environment=TARGET_IP=#{PRIMARY[:ip]}
    Environment=TARGET_PORT=#{TUNNEL_TARGET_PORT}
    Environment=TUNNEL_PORT=#{peer[:tunnel_port]}
    ExecStart=/usr/local/bin/ssh-tunnel.sh
    Restart=always
    RestartSec=3
    TimeoutStopSec=10

    [Install]
    WantedBy=multi-user.target
  UNIT2
end

gen_files["tunnel-demo-open.sh"] = <<~GUISH
  #!/bin/bash
  # Managed by VMs-Labs/Vagrantfile
  # Open a URL inside the auto-logged-in GNOME session of the lab user, reusing
  # that session's real environment (this lab runs a Wayland session).
  #   usage: tunnel-demo-open.sh <url> [user]
  set -u

  URL="${1:?url required}"
  LAB_USER="${2:-#{NEW_USER}}"
  LUID="$(id -u "$LAB_USER")"

  # Wait for the auto-login session. On a fresh "vagrant up" gdm3 has only just
  # been restarted and the desktop may not exist yet, so bailing out here would
  # silently skip the GUI demo. SESSION_TIMEOUT is the give-up point.
  SESSION_TIMEOUT="${SESSION_TIMEOUT:-240}"
  for _ in $(seq 1 "$SESSION_TIMEOUT"); do
    pgrep -u "$LUID" -x gnome-shell >/dev/null 2>&1 && break
    sleep 1
  done
  if ! pgrep -u "$LUID" -x gnome-shell >/dev/null 2>&1; then
    echo "[gui] no gnome-shell session for $LAB_USER after ${SESSION_TIMEOUT}s" >&2
    exit 1
  fi

  # the session exists; now wait for its D-Bus bus to accept connections
  for _ in $(seq 1 90); do
    [ -S "/run/user/$LUID/bus" ] && break
    sleep 1
  done

  ENVARGS=(env "HOME=/home/$LAB_USER" "USER=$LAB_USER" "LOGNAME=$LAB_USER"
           "XDG_RUNTIME_DIR=/run/user/$LUID"
           "DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/$LUID/bus")
  [ -S "/run/user/$LUID/wayland-0" ] && ENVARGS+=("WAYLAND_DISPLAY=wayland-0")
  [ -S /tmp/.X11-unix/X0 ]           && ENVARGS+=("DISPLAY=:0")

  setsid sudo -u "$LAB_USER" -H "${ENVARGS[@]}" \
    firefox --new-window "$URL" >/tmp/tunnel-demo-firefox.log 2>&1 </dev/null &
  echo "[gui] opened $URL for $LAB_USER (log: /tmp/tunnel-demo-firefox.log)"
GUISH

gen_files.each do |fname, body|
  path = File.join(gen_dir, fname)
  if !File.exist?(path) || File.read(path) != body
    File.open(path, "wb") { |f| f.write(body) }
    puts "==> [tunnel] wrote #{path} (#{body.bytesize} bytes)"
  end
end

# Drop generated payloads this configuration no longer uses, so the directory
# reflects reality instead of accumulating demo files from an earlier run.
stale = DEMO ? [] : %w[tunnel-web.py tunnel-web.service]
stale.each do |fname|
  path = File.join(gen_dir, fname)
  next unless File.exist?(path)
  File.delete(path)
  puts "==> [tunnel] removed stale #{path} (DEMO=false)"
end

Vagrant.configure("2") do |config|
  NODES.each do |cfg|
    config.vm.define cfg[:name] do |node|
      node.vm.box = BOX
      node.vm.hostname = cfg[:name]

      # Private Host-Only Network: not routable, not reachable from the internet
      # Data disk size in MB, handed to the guest script so it can identify the
      # right device by size as well as by "not in use". Parsed the way the
      # installer parses it: a bare number means GB, T means TB. lsblk reports
      # -b bytes and this is compared in MB.
      data_mb = begin
        raw = cfg[:disk].to_s
        num = raw[/\d+/].to_f
        num *= (1024 * 1024) if raw =~ /t/i   # TB -> GB
        (num * 1024).to_i                     # GB (explicit or bare) -> MB
      end

      if PROVIDER == "libvirt"
        # libvirt creates a network for this subnet on first use and, left to
        # itself, NATs it to the outside world. forward_mode "none" keeps it
        # isolated like the host-only networks of the other providers (the
        # guests still reach the internet through the management network).
        node.vm.network "private_network", ip: cfg[:ip], libvirt__forward_mode: "none"
        # vagrant-libvirt shares the project folder over NFS by default, which
        # needs an NFS server and sudo on the host. Nothing here uses /vagrant.
        node.vm.synced_folder ".", "/vagrant", disabled: true
      else
        node.vm.network "private_network", ip: cfg[:ip]
      end

      # ---- disks -----------------------------------------------------------
      # The ROOT disk is the box's own, left exactly as it is. It cannot be made
      # smaller: VMware refuses to shrink a virtual disk ("Shrinking disks is
      # not supported") and vmware-vdiskmanager -k is a no-op on this box
      # because the GPT backup header sits at the end of the 64 GB disk. So it
      # is not declared here at all - declaring it only produced a scary warning
      # and changed nothing. It is sparse, so a fresh VM uses about 7 GB.
      #
      # The DATA disk is a second, independent disk whose size is exactly the
      # :disk you configure - any size, no floor. It is formatted, mounted and
      # used by the provisioning script below, and the NFS share lives on it, so
      # "disk: 25GB" really does give you 25 GB of storage.
      #
      # libvirt and Parallels do not implement Vagrant's generic disk option,
      # so their data disk is added in their own provider block below.
      unless %w[libvirt parallels].include?(PROVIDER)
        node.vm.disk :disk, size: cfg[:disk], primary: false, name: "lab-data"
      end

      # ---- resources -------------------------------------------------------
      # TESTED: vmware_desktop. The other branches are written to each
      # provider's documentation but have never been run here.
      node.vm.provider PROVIDER do |v|
        # Only VMware and VirtualBox have a "gui" setting; the others reject it
        # as an unknown option and the whole config fails to validate.
        v.gui = cfg[:gui] if %w[vmware_desktop virtualbox].include?(PROVIDER)
        case PROVIDER
        when "vmware_desktop"
          v.vmx["DisplayName"] = cfg[:label]
          v.vmx["memsize"] = cfg[:ram].to_s
          v.vmx["numvcpus"] = cfg[:cpus].to_s

          # vagrant-vmware-desktop 3.0.5 crashes as soon as a NON-primary disk
          # is attached, with:
          #   disk.rb:129 File.extname(v["filename"])
          #   TypeError: no implicit conversion of nil into String
          # Cause: driver/base.rb#get_disks() groups every "<bus>N:M.<attr>" key
          # in the VMX into one hash per slot, and cap/disk.rb#get_disk() then
          # calls File.extname on v["filename"] for every slot with no nil
          # guard. The bento box ships a stray
          #     scsi0:0.redo = ""
          # with no matching scsi0:0.filename, so that slot hashes to
          # {"redo" => ""} and v["filename"] is nil. A primary disk never hits
          # this line - it is looked up through PRIMARY_DISK_SLOTS instead -
          # which is why the lab worked until the data disk was added.
          # Giving the unused slot an empty filename removes the nil. Safe here:
          # the box's real disk is sata0:0/disk-000004.vmdk and scsi0.present is
          # already "FALSE". Guarded on the box name so a custom box whose disk
          # really does live on scsi0:0 is not clobbered.
          v.vmx["scsi0:0.filename"] = "" if BOX.start_with?("bento/ubuntu-24.04")

          # Boot the system disk, not the (empty, SCSI) data disk - see
          # box_boot_slot. The box is not downloaded until the first "up", so
          # fall back to bento's known slot rather than leaving it unset.
          boot_slot = box_boot_slot(BOX) || (BOX.start_with?("bento/") ? "sata0:0" : nil)
          v.vmx["bios.hddOrder"] = boot_slot if boot_slot
        when "virtualbox"
          v.name = cfg[:label]
          v.customize ["modifyvm", :id,
                       "--memory", cfg[:ram].to_s,
                       "--cpus",   cfg[:cpus].to_s]
        when "libvirt"
          v.memory = cfg[:ram].to_i
          v.cpus   = cfg[:cpus].to_i
          # The data disk. It shows up as /dev/vdb; the guest script finds it
          # by size and "not in use", not by name, so that is fine.
          v.storage :file, size: "#{data_mb / 1024}G"
          # A desktop needs a display; a server does not.
          v.graphics_type = DESKTOP ? "spice" : "none"
          v.video_type    = "virtio" if DESKTOP
        when "parallels"
          v.name   = cfg[:label]
          v.memory = cfg[:ram].to_i
          v.cpus   = cfg[:cpus].to_i
          # "post-import" runs once, right after the VM is cloned from the box.
          # The default event (pre-boot) would add another disk on every boot.
          v.customize "post-import", ["set", :id, "--device-add", "hdd", "--size", data_mb.to_s]
        when "hyperv"
          v.cpus   = cfg[:cpus]
          v.memory = cfg[:ram]
        end
      end

      # =======================================================================
      #  Base provisioner: desktop, user, NFS sharing, auto-login
      # =======================================================================
      node.vm.provision "shell", inline: <<-SHELL
        export DEBIAN_FRONTEND=noninteractive

        NEW_USER=#{Shellwords.escape(NEW_USER)}
        NEW_PASS=#{Shellwords.escape(NEW_PASS)}
        DESKTOP="#{DESKTOP ? 1 : 0}"
        NODE_NAME="#{cfg[:name]}"
        PRIMARY_NAME="#{PRIMARY[:name]}"
        PRIMARY_IP="#{PRIMARY[:ip]}"
        EXPORT_CIDR="#{EXPORT_CIDR}"
        NO_SLEEP="#{cfg[:no_sleep] ? 1 : 0}"
        PROVIDER="#{PROVIDER}"
        # Only VMware needs guest tools for this lab to work. The host-only
        # network, NFS and the SSH tunnel are all kernel/hypervisor features,
        # so on other providers we skip the package rather than risk installing
        # a Guest Additions build that will not compile.
        GUEST_TOOLS="#{PROVIDER == 'vmware_desktop' ? (DESKTOP ? 'open-vm-tools-desktop' : 'open-vm-tools') : ''}"
        TOTAL_STEPS=8

        # Written only once every step below has run. If Vagrant loses its SSH
        # connection mid-way (a host busy enough to freeze the VM for a few
        # seconds trips its keep-alive), it treats this script as finished and
        # moves on while it is in fact still running - the next provisioner
        # then fails in confusing ways. The marker lets it tell the difference.
        BASE_DONE=/var/lib/vms-lab/base.done
        rm -f "$BASE_DONE"

        IS_PRIMARY=0
        [ "$NODE_NAME" = "$PRIMARY_NAME" ] && IS_PRIMARY=1

        # Helper to draw progress bar
        draw_bar() {
          local percent=$1
          local width=20
          local filled=$(( percent * width / 100 ))
          local empty=$(( width - filled ))
          local bar=""
          for ((i=0; i<filled; i++)); do bar="${bar}█"; done
          for ((i=0; i<empty; i++)); do bar="${bar}░"; done
          echo "[${bar}] ${percent}%"
        }

        # Step Runner for APT commands
        run_apt_step() {
          local step_num=$1
          local step_title=$2
          shift 2

          echo "=================================================================="
          echo " STEP ${step_num}/${TOTAL_STEPS}: ${step_title}"
          echo "=================================================================="

          # The progress pipe below hides apt's own exit status, so a failed
          # install used to "complete" and break things much later. Keep
          # stderr in a log, check PIPESTATUS, and retry: the usual causes are
          # a mirror hiccup or unattended-upgrades holding the dpkg lock at
          # first boot, and both clear up on their own.
          local apt_log rc attempt
          apt_log="$(mktemp)"
          for attempt in 1 2 3; do
          local last_phase=""
          local last_p=-1

          apt-get "$@" -o APT::Status-Fd=1 -o DPkg::Lock::Timeout=300 2>"$apt_log" | while read -r line; do
            if [[ "$line" =~ (pmstatus|dlstatus):[^:]*:([0-9]+(\.[0-9]+)?):(.*) ]]; then
              local phase="${BASH_REMATCH[1]}"
              local p_raw="${BASH_REMATCH[2]}"
              local p=$(printf "%.0f" "$p_raw" 2>/dev/null || echo 0)
              local activity="${BASH_REMATCH[4]}"

              if [[ "$phase" != "$last_phase" ]]; then
                last_phase="$phase"
                last_p=-1
              fi

              if (( p >= last_p + 25 )); then
                local bar=$(draw_bar "$p")
                local label="[Download]"
                [[ "$phase" == "pmstatus" ]] && label="[ Install ]"
                echo "   ${bar} | ${label} ${activity}"
                last_p=$p
              fi
            fi
          done
          rc=${PIPESTATUS[0]}
          [ "$rc" -eq 0 ] && break
          echo "   !! apt-get $* failed (exit $rc), attempt ${attempt}/3:"
          tail -n 15 "$apt_log" | sed 's/^/      /'
          if [ "$attempt" -eq 3 ]; then
            rm -f "$apt_log"
            echo "   !! giving up on step ${step_num}. Fix the error above, then: vagrant provision"
            exit 1
          fi
          sleep 15
          [ "$1" = "install" ] && apt-get update -qq >/dev/null 2>&1
          done
          rm -f "$apt_log"

          echo "   $(draw_bar 100) | Step ${step_num} complete."
          echo ""
        }

        # Step 1: Repositories
        run_apt_step 1 "Updating package repositories" update -qq

        # Step 2: Display Manager
        if [ "$DESKTOP" = "1" ]; then
          run_apt_step 2 "Installing GDM3 Display Manager" install -y -qq gdm3
        else
          echo " STEP 2/${TOTAL_STEPS}: display manager skipped (desktop: false)"
        fi

        # Step 3: Hypervisor integration & NFS Utilities
        if [ -n "$GUEST_TOOLS" ]; then
          run_apt_step 3 "Installing Guest Tools & NFS Utilities" install -y -qq "$GUEST_TOOLS" nfs-kernel-server nfs-common
        else
          run_apt_step 3 "Installing NFS Utilities (guest tools skipped on $PROVIDER)" install -y -qq nfs-kernel-server nfs-common
        fi

        # Step 4: Full Desktop GUI
        if [ "$DESKTOP" = "1" ]; then
          run_apt_step 4 "Installing Ubuntu Desktop GUI" install -y -qq ubuntu-desktop
        else
          echo " STEP 4/${TOTAL_STEPS}: desktop GUI skipped (desktop: false - headless server)"
        fi

        # Step 5: User Setup & Live Sync Directory
        echo "=================================================================="
        echo " STEP 5/${TOTAL_STEPS}: Configuring User Account ($NEW_USER) & Folders"
        echo "=================================================================="
        if ! id "$NEW_USER" &>/dev/null; then
          useradd -m -s /bin/bash -G sudo "$NEW_USER"
          echo "$NEW_USER:$NEW_PASS" | chpasswd
        fi

        # ---- data disk ------------------------------------------------------
        # The second disk is exactly the size :disk asked for, and it is the
        # only part of this machine whose size the user actually controls (the
        # root disk is the box's own and cannot be made smaller). So it had
        # better be real: find it, format it once, mount it, and make it
        # survive a reboot. live_share then lives on it.
        #
        # Picking the wrong device here means wipefs on the root filesystem, so
        # the selection is deliberately paranoid. It only ever considers whole
        # disks (TYPE=disk), never partitions, and it rejects a disk if
        # anything on it - the disk or any of its partitions - is mounted or
        # carries a filesystem. Note that "lsblk -no FSTYPE /dev/sda" prints
        # EMPTY on Ubuntu, because the filesystem belongs to /dev/sda2, not to
        # /dev/sda; asking for the device and letting lsblk walk its children is
        # what makes this correct. Matching the exact size Vagrant created is the
        # final guard: if nothing matches, no disk is touched.
        DATA_MNT="/srv/labdata"
        DATA_DISK_MB=#{data_mb}
        DATA_DEV=""
        for d in $(lsblk -ndo NAME,TYPE 2>/dev/null | awk '$2=="disk"{print "/dev/"$1}'); do
          in_use=0
          lsblk -nro MOUNTPOINT "$d" 2>/dev/null | grep -q '[^[:space:]]' && in_use=1
          lsblk -nro FSTYPE    "$d" 2>/dev/null | grep -q '[^[:space:]]' && in_use=1
          [ "$in_use" = 1 ] && continue
          d_mb=$(lsblk -bno SIZE "$d" 2>/dev/null | awk '{printf "%d", $1/1048576}')
          [ "$d_mb" = "$DATA_DISK_MB" ] || continue
          DATA_DEV="$d"; break
        done

        if [ -n "$DATA_DEV" ]; then
          # LABEL=labdata is the marker for "already ours, do not reformat".
          if [ "$(lsblk -no LABEL "$DATA_DEV" 2>/dev/null | tr -d ' ')" != "labdata" ]; then
            wipefs -a "$DATA_DEV" >/dev/null 2>&1 || true
            mkfs.ext4 -q -L labdata "$DATA_DEV"
          fi
          mkdir -p "$DATA_MNT"
          # Order matters: the data disk must be in fstab before the bind below.
          # By label, not device name: /dev/sdX order is not stable across
          # boots (the SCSI data disk and SATA system disk can swap), and a
          # wrong device here drops the VM into emergency mode. nofail lets
          # it boot even if the disk is missing.
          grep -q "labdata" /etc/fstab || \
            echo "LABEL=labdata $DATA_MNT ext4 defaults,noatime,nofail 0 2" >> /etc/fstab
          mountpoint -q "$DATA_MNT" || mount "$DATA_MNT" || true
        fi

        SHARED_DIR="/home/$NEW_USER/live_share"
        mkdir -p "$SHARED_DIR"
        # Keep the familiar path ~/live_share but put the bytes on the data disk.
        if mountpoint -q "$DATA_MNT"; then
          mkdir -p "$DATA_MNT/live_share"
          mountpoint -q "$SHARED_DIR" || mount --bind "$DATA_MNT/live_share" "$SHARED_DIR" || true
          grep -q "bind" /etc/fstab || \
            echo "$DATA_MNT/live_share $SHARED_DIR none bind,nofail,x-systemd.requires-mounts-for=$DATA_MNT 0 0" >> /etc/fstab
        fi

        # Pin live_share directly to GNOME Files left sidebar
        BOOKMARK_DIR="/home/$NEW_USER/.config/gtk-3.0"
        mkdir -p "$BOOKMARK_DIR"
        if ! grep -q "live_share" "$BOOKMARK_DIR/bookmarks" 2>/dev/null; then
          echo "file://$SHARED_DIR live_share" >> "$BOOKMARK_DIR/bookmarks"
        fi

        chown -R $NEW_USER:$NEW_USER "/home/$NEW_USER/live_share" "/home/$NEW_USER/.config"
        if mountpoint -q "$DATA_MNT"; then
          echo "   $(draw_bar 100) | User created; ~/live_share on the data disk ($DATA_DEV, $(df -h --output=size "$DATA_MNT" 2>/dev/null | tail -1 | tr -d ' '))"
        elif [ -n "$DATA_DEV" ]; then
          echo "   $(draw_bar 100) | User created, ~/live_share initialized. WARNING: could not"
          echo "                      mount $DATA_DEV on $DATA_MNT - live_share is on the root disk."
        else
          echo "   $(draw_bar 100) | User created, ~/live_share initialized. NOTE: no data disk was"
          echo "                      attached to this VM, so live_share is on the root disk."
        fi
        echo ""

        # Step 6: Inter-VM Live Tunnel Setup & Auto-Login
        echo "=================================================================="
        echo " STEP 6/${TOTAL_STEPS}: Configuring Live Sync Tunnel & Auto-Login"
        echo "=================================================================="

        # NFS: the primary exports ~/live_share, every peer mounts it.
        # Hosts may be provisioned in parallel, so the mount is retried rather
        # than attempted once - with 3+ nodes a single "mount -a" races.
        if [ "$IS_PRIMARY" = "1" ]; then
          if ! grep -q "$SHARED_DIR" /etc/exports; then
            echo "$SHARED_DIR $EXPORT_CIDR(rw,sync,no_subtree_check,no_root_squash)" >> /etc/exports
            exportfs -a
            systemctl restart nfs-kernel-server
          fi
          echo "   $(draw_bar 100) | NFS export ready for $EXPORT_CIDR"
        else
          if ! grep -q "$PRIMARY_IP:$SHARED_DIR" /etc/fstab; then
            echo "$PRIMARY_IP:$SHARED_DIR $SHARED_DIR nfs defaults,_netdev,nofail,timeo=14,intr 0 0" >> /etc/fstab
          fi
          # Hosts provision in parallel, so a peer can reach this step minutes
          # before the primary finishes installing the desktop and starts its
          # NFS server. Retry generously rather than once, or the share silently
          # fails on any build where the primary is slower than its peers.
          MOUNTED=0
          for i in $(seq 1 150); do
            if mountpoint -q "$SHARED_DIR"; then MOUNTED=1; break; fi
            mount "$SHARED_DIR" >/dev/null 2>&1 && { MOUNTED=1; break; }
            sleep 2
          done
          if [ "$MOUNTED" = "1" ]; then
            echo "   $(draw_bar 100) | live_share mounted from $PRIMARY_IP"
          else
            echo "   !! live_share NOT mounted from $PRIMARY_IP after 5 minutes."
            echo "      The primary is probably still building. Fix with:"
            echo "        vagrant provision $PRIMARY_NAME     # once it has finished"
            echo "        sudo umount $SHARED_DIR; sudo mount $SHARED_DIR"
          fi
        fi

        # Enable Automatic Login (desktop only - a server has no display manager)
        if [ "$DESKTOP" = "1" ]; then
          cat <<EOF > /etc/gdm3/custom.conf
[daemon]
AutomaticLoginEnable=True
AutomaticLogin=$NEW_USER
EOF
          echo "   $(draw_bar 100) | Live tunnel active & Auto-login configured."
        else
          echo "   $(draw_bar 100) | Live share configured (no auto-login on a server)."
        fi
        echo ""

        # Step 7: Power Policy - a lab desktop must never blank, lock or sleep
        echo "=================================================================="
        echo " STEP 7/${TOTAL_STEPS}: Power Policy (never sleep)"
        echo "=================================================================="
        if [ "$NO_SLEEP" = "1" ]; then
          # systemd: ignore the lid and power key, never idle-suspend
          install -d -m 755 /etc/systemd/logind.conf.d
          printf '%s\n' \
            '# Managed by VMs-Labs/Vagrantfile - lab VMs must never sleep' \
            '[Login]' \
            'HandleLidSwitch=ignore' \
            'HandleLidSwitchExternalPower=ignore' \
            'HandlePowerKey=ignore' \
            'IdleAction=ignore' \
            'IdleActionSec=0' > /etc/systemd/logind.conf.d/99-lab-never-sleep.conf
          systemctl mask sleep.target suspend.target hibernate.target hybrid-sleep.target >/dev/null 2>&1

          # GNOME: no idle blanking, no screen lock, no inactivity suspend.
          # Run inside a throwaway session bus so this works during provisioning,
          # before the desktop has ever been logged into. dconf still writes to
          # the user's real profile, so the settings apply at next login.
          if [ "$DESKTOP" = "1" ]; then
          RTMP="$(mktemp -d /run/nosleep.XXXXXX)"
          chown "$NEW_USER:$NEW_USER" "$RTMP"
          chmod 700 "$RTMP"
          sudo -u "$NEW_USER" env XDG_RUNTIME_DIR="$RTMP" HOME="/home/$NEW_USER" \
            dbus-run-session -- sh -c '
              gsettings set org.gnome.desktop.session idle-delay 0
              gsettings set org.gnome.desktop.screensaver idle-activation-enabled false
              gsettings set org.gnome.desktop.screensaver lock-enabled false
              gsettings set org.gnome.settings-daemon.plugins.power sleep-inactive-ac-type "nothing"
              gsettings set org.gnome.settings-daemon.plugins.power sleep-inactive-ac-timeout 0
              gsettings set org.gnome.settings-daemon.plugins.power sleep-inactive-battery-type "nothing"
              gsettings set org.gnome.settings-daemon.plugins.power sleep-inactive-battery-timeout 0
            ' >/dev/null 2>&1
          rmdir "$RTMP" 2>/dev/null
          fi
          echo "   $(draw_bar 100) | sleep targets masked, idle blanking + screen lock disabled"
        else
          echo "   $(draw_bar 100) | power policy left at the GNOME/systemd default"
        fi
        echo ""

        # Step 8: Launch Graphical Environment
        echo "=================================================================="
        echo " STEP 8/${TOTAL_STEPS}: $([ "$DESKTOP" = "1" ] && echo "Starting Graphical Desktop" || echo "Boot target (headless)")"
        echo "=================================================================="
        [ -n "$GUEST_TOOLS" ] && systemctl enable open-vm-tools > /dev/null 2>&1
        if [ "$DESKTOP" = "1" ]; then
          systemctl set-default graphical.target > /dev/null 2>&1
          systemctl restart gdm3
          echo "   $(draw_bar 100) | Graphical session initialized."
        else
          systemctl set-default multi-user.target > /dev/null 2>&1
          echo "   $(draw_bar 100) | Headless server - console / SSH only."
        fi
        echo ""

        install -d -m 755 "$(dirname "$BASE_DONE")"
        date > "$BASE_DONE"
        echo "==> Deployment of $NODE_NAME is complete!"
      SHELL

      # =======================================================================
      #  SSH tunnel lab
      # =======================================================================
      #  primary = sshd + probe web service on :WEB_PORT (host-only interface)
      #  peer    = autossh/systemd local forward 127.0.0.1:tunnel_port ->
      #            primary:WEB_PORT, scoped by PermitOpen to that one target
      #  The two pages opened on each peer's desktop prove the tunnel by eye.

      node.vm.provision "tunnel-key-private", type: "file",
                        source: tunnel_key, destination: "/home/vagrant/tunnel_ed25519"

      node.vm.provision "tunnel-key-public", type: "file",
                        source: "#{tunnel_key}.pub", destination: "/home/vagrant/tunnel_ed25519.pub"

      if DEMO
        node.vm.provision "tunnel-web-app", type: "file",
                          source: File.join(gen_dir, "tunnel-web.py"),
                          destination: "/tmp/tunnel-web.py"

        node.vm.provision "tunnel-web-unit", type: "file",
                          source: File.join(gen_dir, "tunnel-web.service"),
                          destination: "/tmp/tunnel-web.service"
      end

      node.vm.provision "tunnel-gui-launcher", type: "file",
                        source: File.join(gen_dir, "tunnel-demo-open.sh"),
                        destination: "/tmp/tunnel-demo-open.sh"

      if cfg[:role] == :peer
        node.vm.provision "tunnel-client-script", type: "file",
                          source: File.join(gen_dir, "ssh-tunnel.sh"),
                          destination: "/tmp/ssh-tunnel.sh"

        node.vm.provision "tunnel-client-unit", type: "file",
                          source: File.join(gen_dir, "ssh-tunnel-#{cfg[:name]}.service"),
                          destination: "/tmp/ssh-tunnel.service"
      end

      # ---- orchestrator: keys, sshd, units, verification, GUI ---------------
      node.vm.provision "ssh-tunnel", type: "shell", inline: <<-SHELL
        export DEBIAN_FRONTEND=noninteractive

        LAB_USER="#{NEW_USER}"
        NODE_NAME="#{cfg[:name]}"
        NODE_IP="#{cfg[:ip]}"
        PRIMARY_NAME="#{PRIMARY[:name]}"
        PRIMARY_IP="#{PRIMARY[:ip]}"
        WEB_PORT="#{WEB_PORT}"
        TUNNEL_TARGET_PORT="#{TUNNEL_TARGET_PORT}"
        DEMO="#{DEMO ? 1 : 0}"
        DESKTOP="#{DESKTOP ? 1 : 0}"
        TUNNEL_PORT="#{cfg[:tunnel_port]}"
        ROLE="#{cfg[:role]}"
        TOTAL_STEPS=6

        SSHDIR="/home/$LAB_USER/.ssh"
        WEB_SCRIPT="/usr/local/bin/tunnel-web.py"
        WEB_UNIT="/etc/systemd/system/tunnel-web.service"
        TUN_SCRIPT="/usr/local/bin/ssh-tunnel.sh"
        TUN_UNIT="/etc/systemd/system/ssh-tunnel.service"
        OPEN_SCRIPT="/usr/local/bin/tunnel-demo-open.sh"

        IS_PRIMARY=0
        [ "$NODE_NAME" = "$PRIMARY_NAME" ] && IS_PRIMARY=1

        hdr() {
          echo "=================================================================="
          echo " TUNNEL STEP ${1}/${TOTAL_STEPS} [${ROLE}]: ${2}"
          echo "=================================================================="
        }
        bar() {
          local filled=$(( $1 * 20 / 100 )) empty=$(( 20 - $1 * 20 / 100 )) s="" i
          for ((i = 0; i < filled; i++)); do s="${s}█"; done
          for ((i = 0; i < empty; i++)); do s="${s}░"; done
          printf '%s' "$s"
        }
        done_bar() { echo "   [$(bar 100)] $1"; echo ""; }
        fail() { echo "   !! $1"; echo ""; exit 1; }

        # The base setup must really have finished (see BASE_DONE there).
        # Wait a while in case it is still running after a dropped connection.
        for i in $(seq 1 60); do
          [ -f /var/lib/vms-lab/base.done ] && break
          [ "$i" = 1 ] && echo "   waiting for the base setup of $NODE_NAME to finish..."
          sleep 10
        done
        if [ ! -f /var/lib/vms-lab/base.done ]; then
          echo "   !! the base setup of $NODE_NAME never finished (user, packages, share)."
          echo "      Most likely Vagrant lost its SSH connection while the host was busy."
          echo "      Fix it with:   vagrant provision $NODE_NAME"
          exit 1
        fi

        # --- 1 -------------------------------------------------------------
        hdr 1 "Installing SSH + tunnel tooling"
        # Lock timeout: unattended-upgrades often holds dpkg right after boot.
        apt-get -o DPkg::Lock::Timeout=300 update -qq
        apt-get -o DPkg::Lock::Timeout=300 install -y -qq openssh-server openssh-client autossh curl \
          || fail "could not install openssh-server/autossh/curl - see the apt error above, then: vagrant provision $NODE_NAME"
        command -v autossh >/dev/null 2>&1 || echo "   (autossh unavailable, using the plain ssh retry loop)"
        done_bar "openssh-server / openssh-client / autossh / curl ready"

        # --- 2 -------------------------------------------------------------
        hdr 2 "Installing the shared tunnel key for $LAB_USER"
        install -d -m 700 -o "$LAB_USER" -g "$LAB_USER" "$SSHDIR"
        if [ -s /home/vagrant/tunnel_ed25519 ]; then
          install -m 600 -o "$LAB_USER" -g "$LAB_USER" \
            /home/vagrant/tunnel_ed25519 "$SSHDIR/tunnel_ed25519"
        fi
        if [ "$IS_PRIMARY" = "1" ] && [ -s /home/vagrant/tunnel_ed25519.pub ]; then
          touch "$SSHDIR/authorized_keys"
          chown "$LAB_USER:$LAB_USER" "$SSHDIR/authorized_keys"
          chmod 600 "$SSHDIR/authorized_keys"
          grep -qFf /home/vagrant/tunnel_ed25519.pub "$SSHDIR/authorized_keys" \
            || cat /home/vagrant/tunnel_ed25519.pub >> "$SSHDIR/authorized_keys"
        fi
        rm -f /home/vagrant/tunnel_ed25519 /home/vagrant/tunnel_ed25519.pub
        [ -s "$SSHDIR/tunnel_ed25519" ] || fail "no private key at $SSHDIR/tunnel_ed25519 (run the tunnel-key-* provisioners too)"
        FPR="$(ssh-keygen -lf "$SSHDIR/tunnel_ed25519" | awk '{print $2}')"
        if [ "$IS_PRIMARY" = "1" ]; then
          done_bar "private key in place, public key authorised ($FPR)"
        else
          done_bar "private key in place for outbound SSH to $PRIMARY_IP ($FPR)"
        fi

        # --- 3 -------------------------------------------------------------
        hdr 3 "Installing tunnel scripts and units"
        [ -s /tmp/tunnel-demo-open.sh ] || fail "missing staged file /tmp/tunnel-demo-open.sh"
        install -m 755 /tmp/tunnel-demo-open.sh "$OPEN_SCRIPT"
        if [ "$IS_PRIMARY" = "1" ] && [ "$DEMO" = "1" ]; then
          [ -s /tmp/tunnel-web.py ]      || fail "missing staged file /tmp/tunnel-web.py"
          [ -s /tmp/tunnel-web.service ] || fail "missing staged file /tmp/tunnel-web.service"
          install -m 755 /tmp/tunnel-web.py      "$WEB_SCRIPT"
          install -m 644 /tmp/tunnel-web.service "$WEB_UNIT"
        fi
        if [ "$IS_PRIMARY" = "0" ]; then
          [ -s /tmp/ssh-tunnel.sh ]       || fail "missing staged file /tmp/ssh-tunnel.sh"
          [ -s /tmp/ssh-tunnel.service ]  || fail "missing staged file /tmp/ssh-tunnel.service"
          install -m 755 /tmp/ssh-tunnel.sh     "$TUN_SCRIPT"
          install -m 644 /tmp/ssh-tunnel.service "$TUN_UNIT"
        fi
        done_bar "scripts + systemd units installed for role $ROLE"

        # --- 4 -------------------------------------------------------------
        hdr 4 "Hardening sshd (key-only, -L forwards only, lab users only)"
        install -d -m 755 /etc/ssh/sshd_config.d
        # sshd applies the FIRST value it sees per keyword, and
        # /etc/ssh/sshd_config.d/*.conf is Include-d at the top of sshd_config,
        # so this drop-in wins over the shipped defaults. "local" allows -L
        # forwards only: no -R reverse tunnels, no -W streams.
        printf '%s\n' \
          '# Managed by VMs-Labs/Vagrantfile - inter-node SSH tunnel (hardened)' \
          '# key authentication only, enforced regardless of PasswordAuthentication' \
          'AuthenticationMethods publickey' \
          'PubkeyAuthentication yes' \
          'PasswordAuthentication no' \
          'KbdInteractiveAuthentication no' \
          'PermitEmptyPasswords no' \
          '# only the lab user (and vagrant, which Vagrant itself logs in as)' \
          "AllowUsers $LAB_USER vagrant" \
          '# -L forwards only, and only to the single service the tunnel targets' \
          'AllowTcpForwarding local' \
          "PermitOpen $PRIMARY_IP:$TUNNEL_TARGET_PORT" \
          'GatewayPorts no' \
          'X11Forwarding no' \
          'PermitTunnel no' \
          'MaxAuthTries 3' \
          'MaxSessions 5' \
          'LoginGraceTime 30' \
          'ClientAliveInterval 30' \
          'ClientAliveCountMax 4' > /etc/ssh/sshd_config.d/20-tunnel-lab.conf
        # ssh.service creates this at boot, but a bare "sshd -t" needs it too
        install -d -m 0755 /run/sshd
        sshd -t || fail "sshd rejected /etc/ssh/sshd_config.d/20-tunnel-lab.conf (sshd left untouched)"
        systemctl enable ssh >/dev/null 2>&1
        systemctl restart ssh
        sleep 2
        ss -ltn | grep -q ':22 ' || fail "sshd is not listening on port 22"
        done_bar "sshd publickey only, AllowUsers $LAB_USER+vagrant, -L to $PRIMARY_IP:$TUNNEL_TARGET_PORT only"

        # --- 5 -------------------------------------------------------------
        hdr 5 "Starting services and verifying end to end"
        systemctl daemon-reload
        if [ "$IS_PRIMARY" = "1" ] && [ "$DEMO" = "0" ]; then
          echo "   [$(bar 100)] no services to start on the primary (DEMO=false)"
          echo ""
        elif [ "$IS_PRIMARY" = "1" ]; then
          # "enable --now" does NOT re-read a changed unit file, so an already
          # running service would keep its old (possibly wider) bind address.
          systemctl enable tunnel-web.service >/dev/null 2>&1
          systemctl restart tunnel-web.service
          HEALTH=""
          for i in $(seq 1 25); do
            HEALTH="$(curl -fsS --max-time 3 "http://$PRIMARY_IP:$WEB_PORT/health" 2>/dev/null)"
            [ -n "$HEALTH" ] && break
            sleep 1
          done
          [ -n "$HEALTH" ] || { journalctl -u tunnel-web.service -n 15 --no-pager | sed 's/^/   /'; fail "no answer on $PRIMARY_IP:$WEB_PORT"; }
          # assert it is NOT published on every interface
          ss -ltn | grep -q "0.0.0.0:$WEB_PORT" && fail "probe service is bound to 0.0.0.0 - reachable from the NAT network"
          ss -ltn | grep -q "$PRIMARY_IP:$WEB_PORT" || fail "probe service is not bound to $PRIMARY_IP"
          echo "$HEALTH" | sed 's/^/   /'
          done_bar "tunnel-web.service bound to $PRIMARY_IP:$WEB_PORT only (not 0.0.0.0)"
        elif [ "$DEMO" = "1" ]; then
          # same reason: the forward target lives in the unit-installed script,
          # so an already-running tunnel must be restarted to pick up changes
          systemctl enable ssh-tunnel.service >/dev/null 2>&1
          systemctl restart ssh-tunnel.service
          HEALTH=""
          for i in $(seq 1 40); do
            HEALTH="$(curl -fsS --max-time 4 "http://127.0.0.1:$TUNNEL_PORT/health" 2>/dev/null)"
            [ -n "$HEALTH" ] && break
            sleep 2
          done
          if [ -z "$HEALTH" ]; then
            systemctl status ssh-tunnel.service --no-pager -l | tail -n 15 | sed 's/^/   /'
            journalctl -u ssh-tunnel.service -n 20 --no-pager | sed 's/^/   /'
            fail "nothing answered on 127.0.0.1:$TUNNEL_PORT"
          fi
          echo "$HEALTH" | sed 's/^/   /'
          done_bar "127.0.0.1:$TUNNEL_PORT (here) == ssh -L ==> $PRIMARY_IP:$WEB_PORT"
        else
          # DEMO=false: there is no /health endpoint to ask, so verify the thing
          # we actually own - that the local forward is established - and report
          # the far end informationally.
          systemctl enable ssh-tunnel.service >/dev/null 2>&1
          systemctl restart ssh-tunnel.service
          LISTENING=0
          for i in $(seq 1 40); do
            if ss -ltn | grep -q "127.0.0.1:$TUNNEL_PORT "; then LISTENING=1; break; fi
            sleep 2
          done
          if [ "$LISTENING" != "1" ]; then
            systemctl status ssh-tunnel.service --no-pager -l | tail -n 15 | sed 's/^/   /'
            journalctl -u ssh-tunnel.service -n 20 --no-pager | sed 's/^/   /'
            fail "the forward never appeared on 127.0.0.1:$TUNNEL_PORT"
          fi
          if curl -fsS --max-time 5 "http://127.0.0.1:$TUNNEL_PORT/" >/dev/null 2>&1; then
            done_bar "forward up on 127.0.0.1:$TUNNEL_PORT ==> $PRIMARY_IP:$TUNNEL_TARGET_PORT, and the far end answered"
          else
            done_bar "forward up on 127.0.0.1:$TUNNEL_PORT ==> $PRIMARY_IP:$TUNNEL_TARGET_PORT (nothing answering on the far end yet - expected with DEMO=false)"
          fi
        fi

        # --- 6 -------------------------------------------------------------
        hdr 6 "Opening the live test in the graphical desktop"
        DESK="/home/$LAB_USER/Desktop"
        if [ "$DESKTOP" = "0" ]; then
          echo "   [$(bar 100)] skipped - headless server, no browser to open"
          if [ "$DEMO" = "1" ] && [ "$IS_PRIMARY" = "0" ]; then
            echo "                check it from a shell:  curl http://127.0.0.1:$TUNNEL_PORT/health"
          fi
          echo ""
        elif [ "$DEMO" = "0" ]; then
          mkdir -p "$DESK"
          chown "$LAB_USER:$LAB_USER" "$DESK"
          # remove only the two shortcuts this script itself created
          rm -f "$DESK/tunnel-direct.desktop" "$DESK/tunnel-via-ssh.desktop"
          echo "   [$(bar 100)] skipped - DEMO=false, so no browsers are opened"
          echo ""
        else
        mkdir -p "$DESK"
        chown "$LAB_USER:$LAB_USER" "$DESK"
        shortcut() {
          printf '%s\n' '[Desktop Entry]' 'Type=Application' "Name=$1" \
            'Comment=SSH tunnel lab' "Exec=firefox --new-window $2" 'Icon=network-workgroup' \
            'Terminal=false' 'Categories=Network;WebBrowser;' > "$DESK/$3.desktop"
          chown "$LAB_USER:$LAB_USER" "$DESK/$3.desktop"
          chmod 755 "$DESK/$3.desktop"
        }
        GUI_OK=1
        if [ "$IS_PRIMARY" = "1" ]; then
          shortcut "Tunnel lab - direct" "http://$PRIMARY_IP:$WEB_PORT/" "tunnel-direct"
          "$OPEN_SCRIPT" "http://$PRIMARY_IP:$WEB_PORT/" "$LAB_USER" || GUI_OK=0
        else
          shortcut "Tunnel lab - via SSH tunnel" "http://127.0.0.1:$TUNNEL_PORT/" "tunnel-via-ssh"
          shortcut "Tunnel lab - direct (no tunnel)" "http://$PRIMARY_IP:$WEB_PORT/" "tunnel-direct"
          "$OPEN_SCRIPT" "http://$PRIMARY_IP:$WEB_PORT/" "$LAB_USER" || GUI_OK=0
          sleep 8
          "$OPEN_SCRIPT" "http://127.0.0.1:$TUNNEL_PORT/" "$LAB_USER" || GUI_OK=0
        fi
        if [ "$GUI_OK" = "1" ]; then
          done_bar "Firefox opened in the $LAB_USER desktop + desktop shortcuts created"
        else
          echo "   [$(bar 0)] desktop session not reachable - nothing was auto-opened."
          echo "                The shortcuts are on the $LAB_USER desktop; to open manually run:"
          echo "                  sudo $OPEN_SCRIPT <url> $LAB_USER"
          echo ""
        fi
        fi

        echo "=================================================================="
        echo " NODE $NODE_NAME ($NODE_IP) READY  [role: $ROLE]"
        echo "=================================================================="
        if [ "$IS_PRIMARY" = "1" ]; then
          echo "  role         : primary - NFS export, sshd target"
          if [ "$DEMO" = "1" ]; then
            echo "  probe service: http://$PRIMARY_IP:$WEB_PORT/  (host-only interface only)"
          fi
        else
          echo "  role         : peer - NFS client, SSH tunnel client"
          echo "  VIA TUNNEL   : 127.0.0.1:$TUNNEL_PORT  ->  $PRIMARY_IP:$TUNNEL_TARGET_PORT"
          if [ "$DEMO" = "1" ]; then
            echo "  direct       : http://$PRIMARY_IP:$WEB_PORT/   (no tunnel, for comparison)"
          fi
          echo "  unit         : systemctl status ssh-tunnel   (autossh, auto-reconnects)"
        fi
        echo "  live_share   : $(mountpoint -q /home/$LAB_USER/live_share && echo "mounted from $PRIMARY_IP" || echo "not mounted")"
        echo ""
      SHELL
    end
  end
end
