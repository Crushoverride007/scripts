# =============================================================================
#  VMs-Labs :: N-node Ubuntu lab on VMware Desktop
#
#  USAGE
#    1. Edit the CONFIG block below (names, RAM, CPUs, disk, IPs, roles).
#    2. vagrant up
#
#  Each node gets: a host-only IP, a desktop GUI, auto-login as NEW_USER,
#  NFS file sharing from the primary, and a self-healing SSH tunnel to the
#  primary. Nothing is published to the internet: no port forwards, and the
#  probe service binds to the host-only interface only.
# =============================================================================
require "fileutils"
require "shellwords"
require "yaml"

project_dir = File.dirname(File.expand_path(__FILE__))

# ---- sanity check: CRLF would silently break every heredoc below -----------
# The guest payloads are bash scripts embedded in Ruby heredocs, and bash only
# recognises a heredoc terminator at column 0. A Windows editor that saves this
# file as CRLF adds a \r to that terminator, the heredocs stop closing, and the
# build dies with a baffling "unexpected EOF" from deep inside a guest script.
if File.binread(__FILE__).include?("\r")
  raise <<~MSG
    This Vagrantfile has CRLF line endings, which breaks the embedded guest
    scripts. Re-save it as LF (Unix) and run vagrant up again.
    In VS Code: click "CRLF" in the status bar -> "Save with Encoding" -> LF.
  MSG
end

# #############################################################################
# #  CONFIG -- normally in lab.yml, next to this file                          #
# #                                                                            #
# #  lab.yml overrides anything below. The values here are only the DEFAULTS     #
# #  used when there is no lab.yml, so a fresh clone with no config still works.#
# #  This file is ~1200 lines of machinery; you should never need to edit it.   #
# #                                                                            #
# #    box             the Vagrant box to build                                #
# #    provider        vmware_desktop | virtualbox | libvirt | parallels | hyperv #
# #                     chosen explicitly, never auto-detected: the RAM/CPU     #
# #                     and disk calls are per-provider, so a silent fallback   #
# #                     would discard your settings without any error.         #
# #                     vmware_desktop is the only tested one.                 #
# #    subnet          host-only segment, never routed to the internet         #
# #    desktop         true = full Ubuntu desktop + auto-login                  #
# #                     false = headless server (no GUI packages at all)        #
# #    gui             default: show each VM's window?                          #
# #    no_sleep        default: never blank, lock, suspend or hibernate         #
# #    check_host_power  warn if the Windows host itself is set to sleep        #
# #    new_user        created on every VM, auto-logged into the desktop        #
# #    demo            the probe web app + auto-opened browsers (visual proof)  #
# #    web_port        where the demo service listens, on the primary           #
# #    tunnel_port     first peer's local forward; each next peer gets +1       #
# #    tunnel_target_port  what peers forward to; null = same as web_port       #
# #    nodes           one VM per entry. Only :name is required.                #
# #        :role      :primary = NFS export + sshd target + demo service        #
# #                  :peer    = NFS client + SSH tunnel client                 #
# #                  exactly one :primary; the first entry becomes one if      #
# #                  omitted                                                       #
# #        :ip        defaults to subnet.11, .12, .13, ... in list order        #
# #        :ram       MB of RAM        :cpus   vCPU count                       #
# #        :disk      primary disk size                                        #
# #        :gui       show the VM window        (default: gui)                   #
# #        :no_sleep  never blank/lock/suspend  (default: no_sleep)             #
# #        :label     window title              (default: name)                 #
# #############################################################################

DEFAULTS = {
  "box"               => "bento/ubuntu-24.04",
  "provider"          => "vmware_desktop",
  "subnet"            => "192.168.56",
  "desktop"           => true,
  "gui"               => true,
  "no_sleep"          => true,
  "check_host_power"  => true,
  "new_user"          => "Mouhcine",
  "new_pass"          => nil,   # nil = random, kept in .vagrant/lab_password
  "demo"              => true,
  "web_port"          => 8080,
  "tunnel_port"       => 18080,
  "tunnel_target_port" => nil,   # nil means "same as web_port"
  "nodes"             => [
    { "name" => "ubuntu-node-1", "role" => :primary, "ip" => "192.168.56.11",
      "ram" => 8192, "cpus" => 4, "disk" => "20GB", "gui" => true },
    { "name" => "ubuntu-node-2", "role" => :peer, "ip" => "192.168.56.12",
      "ram" => 8192, "cpus" => 4, "disk" => "20GB", "gui" => true },
  ],
}

lab_path = File.join(project_dir, "lab.yml")
LAB =
  if File.exist?(lab_path)
    parsed = begin
      YAML.safe_load(File.read(lab_path), aliases: true) || {}
    rescue StandardError => e
      raise "#{lab_path} is not valid YAML: #{e.message}"
    end
    unless parsed.is_a?(Hash)
      raise "#{lab_path} must be a YAML mapping of key: value pairs"
    end
    DEFAULTS.merge(parsed)
  else
    DEFAULTS
  end

BOX    = LAB["box"]
GUI    = LAB["gui"]

# ---- workaround: a vagrant-vmware-desktop bug that blocks any 2nd disk -------
# vagrant-vmware-desktop 3.0.5 (the latest release) cannot attach a
# NON-primary disk to this box. It dies with:
#   cap/disk.rb:129  File.extname(v["filename"])
#   TypeError: no implicit conversion of nil into String
# Reason: driver/base.rb#get_disks() groups every "<bus>N:M.<attr>" key in the
# box's VMX into one hash per slot, and cap/disk.rb#get_disk() then runs
# File.extname on v["filename"] for every slot with no nil guard. The bento box
# ships a stray
#     scsi0:0.redo = ""
# with no matching scsi0:0.filename, so that slot hashes to {"redo" => ""} and
# v["filename"] is nil. A primary disk never reaches that line - it is looked up
# through PRIMARY_DISK_SLOTS instead - which is why a single-disk lab was fine.
#
# The fix is to give the unused slot an empty filename, which removes the nil
# without touching a real disk (the box's disk is sata0:0 and scsi0.present is
# already "FALSE"). It has to be applied to the BOX, not the Vagrantfile, because
# the Disk action reads the cloned VMX before Vagrant writes any provider
# customisation - setting v.vmx["scsi0:0.filename"] here is too late.
DISK_BUSES = ["nvme", "scsi", "sata", "ide"].freeze

# ---- boot disk: the data disk must not steal the boot ------------------------
# The data disk is attached on a SCSI controller (scsi0:1), and VMware's BIOS
# tries SCSI disks before SATA ones. The box's system disk lives on sata0:0, so
# without an explicit order the VM boots the empty data disk, prints
# "Operating System not found", and vagrant hangs on "Waiting for the VM to
# receive an address". bios.hddOrder pins the boot disk to the box's own slot,
# read from the box's VMX rather than assumed, so other boxes work too.
def box_boot_slot(box)
  home = ENV["VAGRANT_HOME"] || File.join(Dir.home, ".vagrant.d")
  root = File.join(home, "boxes", box.gsub("/", "-VAGRANTSLASH-"))
  vmx  = Dir.glob(File.join(root, "**", "*.vmx")).max_by { |p| File.mtime(p) }
  return nil unless vmx
  File.readlines(vmx).each do |line|
    if (m = line.match(/\A\s*((?:#{DISK_BUSES.join("|")})\d+:\d+)\.filename\s*=\s*"[^"]+\.vmdk"/i))
      return m[1].downcase
    end
  end
  nil
rescue StandardError
  nil
end

def patch_box_vmx(box)
  home  = ENV["VAGRANT_HOME"] || File.join(Dir.home, ".vagrant.d")
  # Vagrant mangles "/" to "VAGRANTSLASH-" in the on-disk box directory name.
  mangled = box.gsub("/", "-VAGRANTSLASH-")
  root = File.join(home, "boxes", mangled)
  return nil unless Dir.exist?(root)
  fixed = []
  Dir.glob(File.join(root, "**", "*.vmx")).each do |vmx_path|
    lines = File.readlines(vmx_path)
    # Group every bus slot by name, then note which have no filename at all.
    slots = Hash.new { |h, k| h[k] = [] }
    lines.each do |line|
      # NB the (?: ) - with a plain ( ) the \d+:\d+ ends up inside the last
      # alternative, so the pattern only ever matches a literal "ide0:0".
      if line =~ /^\s*((?:#{DISK_BUSES.join("|")})\d+:\d+)\.(\S+)\s*=/i
        slots[Regexp.last_match(1)] << Regexp.last_match(2).downcase
      end
    end
    orphans = slots.reject { |_, attrs| attrs.include?("filename") }.keys.sort
    next if orphans.empty?
    backup = "#{vmx_path}.pre-lab-disk-fix"
    FileUtils.cp(vmx_path, backup) unless File.exist?(backup)
    body = lines.join
    orphans.each do |slot|
      body << "\n#{slot}.filename = \"\"\n"
    end
    File.write(vmx_path, body)
    fixed << [File.basename(vmx_path), orphans]
  end
  fixed
rescue => e
  puts "==> [lab] NOTE: could not check the box's disk config (#{e.class})."
  nil
end

SUBNET = LAB["subnet"]
NO_SLEEP = LAB["no_sleep"]
CHECK_HOST_POWER = LAB["check_host_power"]
PROVIDER = LAB["provider"]
NEW_USER = LAB["new_user"].to_s
new_pass = LAB["new_pass"].to_s
# Both end up in guest shell scripts and in useradd, so refuse anything that is
# not a plain login name, and shell-quote the password wherever it is used.
unless NEW_USER.match?(/\A[A-Za-z_][A-Za-z0-9_-]{0,31}\z/)
  raise "new_user #{NEW_USER.inspect} is not a valid login name (letters, digits, - and _)"
end
# No password in lab.yml (or the example's placeholder): never fall back to a
# fixed one - this file is public, so that would be a known sudo password on
# every VM. Generate one per project instead, keep it in .vagrant/ (git-ignored)
# so every run and every node agrees, and say where it is.
if new_pass.empty? || new_pass == "change-me"
  pass_file = File.join(project_dir, ".vagrant", "lab_password")
  unless File.exist?(pass_file)
    require "securerandom"
    FileUtils.mkdir_p(File.dirname(pass_file))
    File.write(pass_file, SecureRandom.alphanumeric(16))
  end
  new_pass = File.read(pass_file).strip
  puts "==> [lab] login   : #{NEW_USER} / #{new_pass}   (generated, in .vagrant/lab_password)"
end
NEW_PASS = new_pass
# Anything but an explicit false means desktop, so an old lab.yml without the
# key keeps building exactly what it always did.
DESKTOP = LAB["desktop"] != false
DEMO = LAB["demo"]
WEB_PORT = LAB["web_port"].to_i
TUNNEL_PORT = LAB["tunnel_port"].to_i
TUNNEL_TARGET_PORT = (LAB["tunnel_target_port"] || LAB["web_port"]).to_i

# node keys come from YAML as strings; normalise to symbols for the rest of
# the file, which has always used symbol keys
NODES = Array(LAB["nodes"]).map do |n|
  raise "every node needs a name: #{n.inspect}" if n["name"].to_s.strip.empty?
  h = n.transform_keys(&:to_sym)
  # lab.yml writes role as a plain string ("peer") while the built-in defaults
  # use a symbol (:peer). Without this, every `cfg[:role] == :peer` test is
  # silently false, so peers never get their tunnel unit staged and the build
  # dies with "missing staged file /tmp/ssh-tunnel.sh".
  if h[:role]
    r = h[:role].to_s.strip.downcase
    unless %w[primary peer].include?(r)
      raise "node #{h[:name]}: role must be 'primary' or 'peer', got #{h[:role].inspect}"
    end
    h[:role] = r.to_sym
  end
  h
end

if PROVIDER == "vmware_desktop" && !NODES.nil? && !NODES.empty?
  patched = patch_box_vmx(BOX)
  if patched && !patched.empty?
    patched.each do |name, orphans|
      puts "==> [lab] box fix: #{name} had a disk slot with no filename " \
           "(#{orphans.join(", ")}), which crashes vagrant-vmware-desktop when a"
      puts "==> [lab]          second disk is attached. Added an empty filename. " \
           "Original saved as <box>.vmx.pre-lab-disk-fix"
    end
  elsif !Dir.exist?(File.join(ENV["VAGRANT_HOME"] || File.join(Dir.home, ".vagrant.d"),
                             "boxes", BOX.gsub("/", "-VAGRANTSLASH-")))
    puts "==> [lab] NOTE: box #{BOX} is not downloaded yet."
    puts "==> [lab]        The first 'vagrant up' downloads it and may then fail on:"
    puts "==> [lab]          TypeError: no implicit conversion of nil into String"
    puts "==> [lab]        (a vagrant-vmware-desktop bug with this box). Just run"
    puts "==> [lab]        'vagrant up' a second time - this check then patches it."
  end
end

# #############################################################################
# #  END CONFIG  --  everything below is generic, no edits needed               #
# #############################################################################

# ---- fill in defaults -------------------------------------------------------
NODES.each_with_index do |n, i|
  n[:role] = i.zero? ? :primary : :peer if n[:role].nil?
  n[:ip]   = "#{SUBNET}.#{11 + i}"              if n[:ip].nil?
  n[:ram]  = 4096                               if n[:ram].nil?
  n[:cpus] = 2                                  if n[:cpus].nil?
  n[:disk] = "30GB"                             if n[:disk].nil?
  n[:gui]  = GUI                                if n[:gui].nil?
  n[:no_sleep] = NO_SLEEP                        if n[:no_sleep].nil?
  n[:label] = n[:name]                          if n[:label].nil?
end

# ---- validate ---------------------------------------------------------------
raise "NODES is empty - add at least one entry" if NODES.empty?

# ---- provider ---------------------------------------------------------------
SUPPORTED_PROVIDERS = {
  "vmware_desktop" => { label: "VMware Workstation / Fusion", tested: true },
  "virtualbox"     => { label: "Oracle VirtualBox",            tested: false },
  "libvirt"        => { label: "libvirt / KVM (Linux)",        tested: false },
  "parallels"      => { label: "Parallels Desktop (macOS)",    tested: false },
  "hyperv"         => { label: "Microsoft Hyper-V",            tested: false },
}
unless SUPPORTED_PROVIDERS.key?(PROVIDER)
  raise <<~MSG
    unknown PROVIDER #{PROVIDER.inspect}
      valid options: #{SUPPORTED_PROVIDERS.keys.join(', ')}
    Pick one and run vagrant up again. (A stray space is the usual cause.)
  MSG
end
PROVIDER_INFO = SUPPORTED_PROVIDERS[PROVIDER]

# ---- is the provider's Vagrant plugin actually installed? -------------------
# Without this, a missing plugin does not fail loudly: Vagrant simply matches
# no provider block, falls back to whatever it finds first, and your RAM/CPU
# and disk settings are discarded without a word.
begin
  # the registry keys are Symbols, so compare as Strings - join/sort make them
  # *look* like strings, which hides the mismatch until include? silently
  # returns false and the guard rejects a provider that is in fact installed
  _have = Vagrant.plugin("2").manager.providers.keys.map(&:to_s)
rescue StandardError
  _have = nil # could not introspect the registry; do not block the build on it
end
if _have && !_have.include?(PROVIDER)
  hint = case PROVIDER
         when "vmware_desktop" then "vagrant plugin install vagrant-vmware-desktop"
         when "libvirt"        then "install libvirt + qemu-kvm, then: vagrant plugin install vagrant-libvirt"
         when "parallels"      then "vagrant plugin install vagrant-parallels"
         else "#{PROVIDER} needs its Vagrant plugin installed too"
         end
  raise "the Vagrant provider plugin for #{PROVIDER.inspect} is not installed.\n  fix: #{hint}\n  installed providers: #{_have.sort.join(', ')}"
end

primaries = NODES.select { |n| n[:role] == :primary }
raise "only one node may have role: :primary (found #{primaries.size})" if primaries.size > 1

# Guard against a config-source mismatch (lab.yml strings vs built-in symbols)
# silently disabling the per-role file provisioners. Cheap to check here,
# expensive to discover halfway through a build.
_stray = NODES.reject { |n| [:primary, :peer].include?(n[:role]) }
unless _stray.empty?
  raise "node roles must be the symbols :primary / :peer, got " \
        "#{_stray.map { |n| "#{n[:name]}=#{n[:role].inspect}" }.join(', ')}"
end

PRIMARY = primaries.first || NODES.first
PEERS   = NODES - [PRIMARY]
PEERS.each_with_index { |n, i| n[:tunnel_port] = TUNNEL_PORT + i }
_missing = PEERS.select { |n| n[:tunnel_port].nil? }
raise "these peers have no tunnel port, so they cannot be provisioned: " \
      "#{_missing.map { |n| n[:name] }.join(', ')}" unless _missing.empty?

%w[name ip].each do |field|
  dupes = NODES.group_by { |n| n[field.to_sym] }.select { |_, v| v.size > 1 }.keys
  raise "duplicate node #{field}: #{dupes.join(', ')}" unless dupes.empty?
end

EXPORT_CIDR = "#{SUBNET}.0/24"
# "18080=ubuntu-node-2,18081=ubuntu-node-3" - lets the probe page name the peer
TUNNEL_MAP  = PEERS.map { |n| "#{n[:tunnel_port]}=#{n[:name]}" }.join(",")

puts "==> [lab] #{NODES.size} VM(s), #{(NODES.map { |n| n[:ram] }.sum / 1024.0).round(1)} GB RAM total"
puts "==> [lab] primary: #{PRIMARY[:name]} (#{PRIMARY[:ip]})   peers: #{PEERS.map { |n| "#{n[:name]}=#{n[:tunnel_port]}" }.join(' ') || 'none'}"
if PROVIDER_INFO[:tested]
  puts "==> [lab] provider: #{PROVIDER} (#{PROVIDER_INFO[:label]})"
else
  puts "==> [lab] provider: #{PROVIDER} (#{PROVIDER_INFO[:label]})  ** UNTESTED **"
  puts "==> [lab]          this path has never been run - it was written to spec only."
  puts "==> [lab]          the lab features that matter (host-only network, NFS, SSH"
  puts "==> [lab]          tunnel, hardening) are provider-agnostic, but resource and"
  puts "==> [lab]          disk settings for this provider are unconfirmed."
end

puts "==> [lab] flavour : #{DESKTOP ? 'desktop (GNOME, auto-login)' : 'server (headless, no GUI packages)'}"
if DEMO
  puts "==> [lab] demo    : ON  - probe web app on #{PRIMARY[:name]}:#{WEB_PORT}" \
       "#{DESKTOP ? ', browsers auto-opened' : ' (check it with curl - no desktop)'}"
else
  puts "==> [lab] demo    : OFF - no web app, no auto-opened browsers."
  puts "==> [lab]          each peer's tunnel forwards to #{PRIMARY[:ip]}:#{TUNNEL_TARGET_PORT}."
  if PEERS.any?
    puts "==> [lab]          nothing is listening there yet unless you start it, so the"
    puts "==> [lab]          tunnel will be up but the far end will not answer."
  end
end

# ---- warn about machines that exist on disk but are no longer configured -----
# Deleting an entry from NODES makes Vagrant forget that VM: it keeps running in
# the hypervisor, untracked, and "vagrant destroy <name>" stops working. An
# empty directory left behind by an earlier run is only residue, so require real
# state inside it before calling it an orphan.
machines_dir = File.join(project_dir, ".vagrant", "machines")
orphans = []
if Dir.exist?(machines_dir)
  orphans = Dir.children(machines_dir).select do |name|
    next false if NODES.any? { |n| n[:name] == name }
    state = File.join(machines_dir, name)
    Dir.exist?(state) && !Dir.children(state).empty?
  end.sort
end

unless orphans.empty?
  puts "==> [lab] WARNING: #{orphans.size} VM(s) exist on disk but are not in NODES:"
  orphans.each { |o| puts "==> [lab]            - #{o}   (still running, Vagrant no longer tracks it)" }
  puts "==> [lab]          to keep one:  add it back to NODES."
  puts "==> [lab]          to drop one:   vagrant global-status --prune"
  puts "==> [lab]                         then delete the VM in the hypervisor."
  puts "==> [lab]          NOTE: 'vagrant destroy <name>' only works while the entry is still"
  puts "==> [lab]          in NODES - always destroy BEFORE deleting the line."
  puts ""
end

# ---- warn if the configured data disk is tiny --------------------------------
# The data disk is created at exactly the configured size, so there is no floor
# to enforce - this only flags a size that is too small to be useful, which is
# a judgement call rather than a provider limitation.
# (The root disk used to be warned about here. It is now the box's own disk,
# left untouched: VMware cannot shrink a virtual disk, so a smaller request was
# never achievable and only ever produced "Shrinking disks is not supported".)
tiny_data = NODES.select do |n|
  raw = n[:disk].to_s
  num = raw[/\d+/].to_i
  num *= 1024 if raw =~ /t/i
  num < 4
end

unless tiny_data.empty?
  puts "==> [lab] WARNING: #{tiny_data.size} node(s) have a data disk under 4 GB:"
  tiny_data.each { |n| puts "==> [lab]            - #{n[:name]}: #{n[:disk]}" }
  puts "==> [lab]          It will be created and mounted, but a few GB fills up fast."
  puts ""
end

# ---- warn if the HOST will put the VMs to sleep ------------------------------
# NO_SLEEP stops a guest suspending itself, but it cannot stop the hypervisor
# forcing a suspend when the host sleeps. powercfg's labels are localised, so
# the two values are read positionally (the last two hex fields of a single
# setting query are always "Current AC" then "Current DC"). Units are seconds.
SUB_SLEEP_GUID    = "238c9fa8-0aad-41ed-83f4-97be242c8f20"
SUB_BUTTONS_GUID  = "4f971e89-eebd-4455-a8de-9e59040e7347"
STANDBYIDLE_GUID  = "29f6c1db-86da-48c5-9fdb-f2b67b1f44da"
HIBERNATEIDLE_GUID = "9d7815a6-7ee4-497e-8888-515a05f02364"
LIDACTION_GUID    = "5ca83367-6e45-459f-a27b-476b1d01c936"
MAX_PLAUSIBLE_SLEEP = 7 * 24 * 3600   # a week: anything wilder means we mis-parsed

def host_power_reading
  return nil unless RUBY_PLATFORM =~ /mswin|mingw|cygwin/
  require "open3"
  read = lambda do |sub, set|
    out, _st = Open3.capture2("powercfg", "/query", "SCHEME_CURRENT", sub, set)
    hex = out.scan(/0x[0-9a-fA-F]{8}/)
    hex.size >= 2 ? [hex[-2].to_i(16), hex[-1].to_i(16)] : nil
  end
  {
    standby:   read.call(SUB_SLEEP_GUID, STANDBYIDLE_GUID),
    hibernate: read.call(SUB_SLEEP_GUID, HIBERNATEIDLE_GUID),
    # absent on desktops with no lid - that is fine, it just means no lid
    lid:       read.call(SUB_BUTTONS_GUID, LIDACTION_GUID),
  }
rescue StandardError
  nil
end

if CHECK_HOST_POWER
  hp = host_power_reading
  if hp
    fmt = lambda do |secs|
      return "never" if secs.zero?
      return "#{secs}s" if secs < 60 || (secs % 60).nonzero?
      "#{secs / 60} min"
    end
    ac_issues = []
    dc_issues = []
    # A LIDACTION setting only exists on machines that actually have a lid, which
    # makes it a free proxy for "this is a laptop". Battery-only findings are
    # therefore only reported when one is present - on a desktop the DC values
    # are leftovers from the OEM image and mean nothing.
    lid_present = !hp[:lid].nil?
    if (s = hp[:standby])
      ac_issues << "sleeps after #{fmt.call(s[0])} (plugged in)" if s[0].between?(1, MAX_PLAUSIBLE_SLEEP)
      dc_issues << "sleeps after #{fmt.call(s[1])} (on battery)" if lid_present && s[1].between?(1, MAX_PLAUSIBLE_SLEEP)
    end
    if (h = hp[:hibernate])
      ac_issues << "hibernates after #{fmt.call(h[0])} (plugged in)" if h[0].between?(1, MAX_PLAUSIBLE_SLEEP)
    end
    if (l = hp[:lid]) && l[0].between?(1, 3)
      ac_issues << "lid action is #{%w[do-nothing sleep hibernate shutdown][l[0]]}"
    end

    if ac_issues.empty? && dc_issues.empty?
      puts "==> [lab] host power: OK, the host will not sleep the VMs (AC standby/hibernate disabled)"
    else
      puts "==> [lab] WARNING: the Windows host is set to sleep. NO_SLEEP inside the guests"
      puts "==> [lab]          cannot prevent that - the hypervisor will suspend the VMs."
      ac_issues.each { |i| puts "==> [lab]            plugged in : #{i}" }
      dc_issues.each { |i| puts "==> [lab]            battery     : #{i}" }
      puts "==> [lab]          Fix: Settings > System > Power > 'When plugged in, put the device"
      puts "==> [lab]          to sleep: Never'   (or: powercfg /change standby-timeout-ac 0)"
    end
  end
end

# ---- one keypair shared by every node ---------------------------------------
# Generated once on the HOST so the nodes can be provisioned in any order and
# still end up with identical key material. Vagrant ships it to all of them.
key_dir     = File.join(project_dir, ".vagrant", "keys")
tunnel_key  = File.join(key_dir, "tunnel_ed25519")

unless File.exist?(tunnel_key) && File.exist?("#{tunnel_key}.pub")
  FileUtils.mkdir_p(key_dir)
  FileUtils.rm_f([tunnel_key, "#{tunnel_key}.pub"])
  puts "==> [tunnel] generating shared SSH keypair: #{tunnel_key}"
  # NOTE: the empty "-N" passphrase must be passed as a real empty argument.
  # Ruby's spawn does that correctly; cmd.exe/PowerShell silently drop it.
  system("ssh-keygen", "-q", "-t", "ed25519", "-N", "", "-C", "vagrant-lab-tunnel", "-f", tunnel_key)
  unless File.exist?("#{tunnel_key}.pub")
    system("ssh-keygen", "-q", "-t", "rsa", "-b", "2048", "-N", "", "-C", "vagrant-lab-tunnel", "-f", tunnel_key)
  end
  raise "[tunnel] could not create #{tunnel_key} - is ssh-keygen on PATH?" unless File.exist?("#{tunnel_key}.pub")
end

# ---- guest-side scripts, rendered here on the host --------------------------
# Vagrant's "file" provisioner only takes :source (no :content), so the payloads
# are written next to the Vagrantfile and shipped as plain files. LF endings are
# required: the tunnel client and the orchestrator are bash.
gen_dir = File.join(project_dir, ".vagrant", "tunnel")
FileUtils.mkdir_p(gen_dir)
gen_files = {}

# The probe web app is DEMO-only scaffolding. With DEMO=false nothing here is
# generated, shipped, installed or started, and no browsers are opened.
web_py = <<~'PYWEB'
  #!/usr/bin/env python3
  """Tunnel Lab probe service - provisioned by VMs-Labs/Vagrantfile.

  Runs on the primary node and is reachable two different ways:

    DIRECT    http://<primary>:8080/     a peer talks straight to the primary
    TUNNELLED http://127.0.0.1:18080/    a peer -> ssh -L -> primary:8080

  TUNNEL_MAP arrives as "18080=node-2,18081=node-3", so the page can tell you
  which peer a tunnelled request came from and label the route accordingly.
  """
  import base64
  import html
  import json
  import os
  import sys
  import threading
  import time
  from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

  PORT = int(os.environ.get("WEB_PORT", "8080"))
  # Bind to the host-only address, never 0.0.0.0: the NAT interface must not
  # expose the probe service. Set via BIND in tunnel-web.service.
  BIND = os.environ.get("BIND", "0.0.0.0")
  SERVER = os.uname().nodename

  TUNNEL_MAP = {}
  for pair in os.environ.get("TUNNEL_MAP", "").split(","):
      if "=" in pair:
          port, owner = pair.split("=", 1)
          TUNNEL_MAP[port.strip()] = owner.strip()

  STARTED = time.time()
  FAVICON = base64.b64decode("R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7")
  _lock = threading.Lock()
  _hits = 0

  PAGE = """<!DOCTYPE html>
  <html lang="en">
  <head>
  <meta charset="utf-8">
  <title>SSH Tunnel Lab</title>
  <style>
    * { box-sizing: border-box; }
    body { margin: 0; min-height: 100vh; display: flex; align-items: center;
           justify-content: center; padding: 26px; color: #e7ebf3;
           font-family: Ubuntu, "DejaVu Sans", system-ui, sans-serif;
           background: radial-gradient(circle at 18% 0%, #1b2333 0%, #0c0e13 62%); }
    .card { width: 100%; max-width: 800px; padding: 30px 34px; border-radius: 16px;
            background: #141821; border: 1px solid #262c3a;
            box-shadow: 0 24px 60px rgba(0,0,0,.55); }
    h1 { margin: 0; font-size: 15px; letter-spacing: .18em; text-transform: uppercase;
         color: #8b93a7; font-weight: 600; }
    h2 { margin: 12px 0 6px; font-size: 24px; line-height: 1.25; }
    .b-tunnel { color: #3ddc97; }
    .b-direct { color: #6ea8fe; }
    .sub { margin: 0 0 20px; font-size: 14px; color: #8b93a7; }
    .row { display: flex; justify-content: space-between; gap: 18px; padding: 10px 0;
           border-bottom: 1px solid #1e2431; }
    .row:last-of-type { border-bottom: 0; }
    .k { color: #8b93a7; font-size: 14px; white-space: nowrap; }
    .v { font-size: 14px; text-align: right; word-break: break-all;
         font-family: "Ubuntu Mono", "DejaVu Sans Mono", monospace; }
    .good { color: #3ddc97; }
    .warn { color: #ffb454; }
    .note { margin-top: 20px; padding: 14px 16px; font-size: 13.5px; line-height: 1.6;
            color: #b9c0d0; background: #10141c; border-left: 3px solid #6ea8fe;
            border-radius: 0 8px 8px 0; }
    .foot { margin-top: 18px; display: flex; align-items: center; gap: 12px; }
    button { background: #232a38; color: #e7ebf3; border: 1px solid #333c4e;
             border-radius: 8px; padding: 9px 15px; font-size: 13px; cursor: pointer;
             font-family: inherit; }
    button:hover { background: #2b3444; }
    .tick { font-size: 12.5px; color: #767f94; }
  </style>
  </head>
  <body>
  <div class="card">
    <h1>SSH Tunnel Lab</h1>
    <h2 class="@@CLASS@@">@@ROUTE@@</h2>
    <div class="sub">@@SUBTITLE@@</div>
    <div class="row"><span class="k">Browser asked for (Host header)</span><span class="v @@HOSTCLASS@@">@@HOSTHDR@@</span></div>
    <div class="row"><span class="k">Source address seen by the server</span><span class="v">@@CLIENTIP@@</span></div>
    <div class="row"><span class="k">Path the request travelled</span><span class="v">@@PATH@@</span></div>
    <div class="row"><span class="k">Tunnel port owner</span><span class="v">@@OWNER@@</span></div>
    <div class="row"><span class="k">Requests served</span><span class="v">@@HITS@@</span></div>
    <div class="row"><span class="k">Server uptime</span><span class="v" id="up">@@UPTIME@@</span></div>
    <div class="row"><span class="k">Server clock</span><span class="v" id="clock">--:--:--</span></div>
    <div class="note">@@NOTE@@</div>
    <div class="foot">
      <button onclick="location.reload()">Refresh now</button>
      <button id="autoBtn">Pause auto-refresh</button>
      <span class="tick" id="state">auto-refresh every 4s - watch the request counter climb</span>
    </div>
  </div>
  <script>
    var started = @@STARTED@@, t0 = Date.now();
    function pad(n) { return (n < 10 ? "0" : "") + n; }
    function dur(s) {
      var h = Math.floor(s / 3600), m = Math.floor(s % 3600 / 60), x = Math.floor(s % 60);
      return h + "h " + pad(m) + "m " + pad(x) + "s";
    }
    function tick() {
      var d = new Date();
      document.getElementById("clock").textContent =
        pad(d.getHours()) + ":" + pad(d.getMinutes()) + ":" + pad(d.getSeconds());
      document.getElementById("up").textContent = dur(started + (Date.now() - t0) / 1000);
    }
    setInterval(tick, 1000); tick();
    var auto = true, timer = null;
    function arm() {
      clearInterval(timer);
      timer = setInterval(function () { if (auto) { location.reload(); } }, 4000);
    }
    arm();
    document.getElementById("autoBtn").onclick = function () {
      auto = !auto;
      this.textContent = auto ? "Pause auto-refresh" : "Resume auto-refresh";
      document.getElementById("state").textContent = auto
        ? "auto-refresh every 4s - watch the request counter climb" : "paused";
    };
  </script>
  </body>
  </html>
  """

  class Handler(BaseHTTPRequestHandler):
      server_version = "TunnelLab/1.0"
      protocol_version = "HTTP/1.1"

      def _respond(self, code, body, ctype="text/html; charset=utf-8"):
          raw = body if isinstance(body, bytes) else body.encode("utf-8")
          self.send_response(code)
          self.send_header("Content-Type", ctype)
          self.send_header("Content-Length", str(len(raw)))
          self.send_header("Cache-Control", "no-store")
          self.end_headers()
          if raw:
              self.wfile.write(raw)

      def _snapshot(self):
          global _hits
          host = self.headers.get("Host", "(none)")
          port = host.rsplit(":", 1)[-1] if ":" in host else "80"
          owner = TUNNEL_MAP.get(port)
          tunnelled = owner is not None
          with _lock:
              _hits += 1
              hits = _hits
          client = self.client_address[0]
          if tunnelled:
              route = "REACHED THROUGH THE SSH TUNNEL"
              subtitle = "Requested on " + owner + ", rendered by " + SERVER
              path = owner + " browser > 127.0.0.1:" + port + " > ssh -L > " + SERVER + ":" + str(PORT)
              note = ("This browser lives on <b>" + owner + "</b> and asked for 127.0.0.1:" + port +
                      " - a port that exists <b>only on that node</b> - yet this page is rendered by <b>" +
                      SERVER + "</b>, which does not listen on that port at all. The request was carried " +
                      "inside the SSH session, and the far end of that session then opened a brand-new " +
                      "connection to the primary's host-only address. That is why the source address above is " +
                      "the primary itself rather than " + owner + " - it is a new connection, not a relayed one. " +
                      "The proof is the <b>Host header</b> and the fact that the tunnel is scoped to port " +
                      port + " only.")
          else:
              route = "DIRECT - NO TUNNEL INVOLVED"
              subtitle = "Ordinary TCP to the peer over the host-only network"
              path = "browser > " + SERVER + ":" + str(PORT) + " (no SSH hop)"
              note = ("Straight to " + SERVER + " over the host-only network, no SSH involved. Here the server " +
                      "sees the <b>real</b> address of the machine that opened the browser (" + client +
                      "), which is the clearest difference between this tab and a tunnelled one.")
          return {
              "route": route, "subtitle": subtitle, "path": path, "note": note,
              "tunnelled": tunnelled, "server": SERVER, "host_header": host,
              "client_ip": client, "hits": hits, "owner": owner or "(none - not a tunnel port)",
              "uptime": int(time.time() - STARTED), "started": STARTED,
              "remote": str(self.client_address), "time": time.strftime("%Y-%m-%d %H:%M:%S"),
              "tunnel_map": TUNNEL_MAP,
          }

      def _page(self, s):
          vals = {
              "CLASS": "b-tunnel" if s["tunnelled"] else "b-direct",
              "ROUTE": s["route"], "SUBTITLE": s["subtitle"],
              "HOSTHDR": s["host_header"],
              # the Host header is the reliable discriminator: a tunnel port
              # exists only on its peer, so seeing it here is the proof
              "HOSTCLASS": "good" if s["tunnelled"] else "warn",
              "CLIENTIP": s["client_ip"], "PATH": s["path"], "OWNER": s["owner"],
              "HITS": s["hits"], "UPTIME": str(s["uptime"]) + "s", "NOTE": s["note"],
              "STARTED": repr(s["started"]),
          }
          # only the values that came from the request itself get escaped
          escape = ("HOSTHDR", "CLIENTIP", "SUBTITLE")
          page = PAGE
          for k, v in vals.items():
              text = html.escape(str(v), quote=True) if k in escape else str(v)
              page = page.replace("@@" + k + "@@", text)
          return page

      def do_GET(self):
          path = self.path.split("?", 1)[0]
          if path == "/favicon.ico":
              return self._respond(200, FAVICON, "image/gif")
          snap = self._snapshot()
          if path == "/health":
              return self._respond(200, json.dumps(snap, indent=2) + "\n", "application/json")
          self._respond(200, self._page(snap))

      def log_message(self, fmt, *args):
          sys.stderr.write("[tunnel-web] %s - %s\n" % (self.address_string(), fmt % args))

  if __name__ == "__main__":
      srv = ThreadingHTTPServer((BIND, PORT), Handler)
      srv.daemon_threads = True
      print("[tunnel-web] listening on %s:%d  tunnels=%s" % (BIND, PORT, TUNNEL_MAP or "none"), flush=True)
      srv.serve_forever()
PYWEB

web_service = <<~UNIT1
  [Unit]
  Description=Tunnel Lab probe web service (Vagrant-managed)
  After=network-online.target
  Wants=network-online.target

  [Service]
  Type=simple
  User=#{NEW_USER}
  Group=#{NEW_USER}
  Environment=HOME=/home/#{NEW_USER}
  Environment=WEB_PORT=#{WEB_PORT}
  Environment=BIND=#{PRIMARY[:ip]}
  Environment=TUNNEL_MAP=#{TUNNEL_MAP}
  ExecStart=/usr/bin/python3 /usr/local/bin/tunnel-web.py
  WorkingDirectory=/home/#{NEW_USER}
  Restart=always
  RestartSec=2

  [Install]
  WantedBy=multi-user.target
UNIT1

if DEMO
  gen_files["tunnel-web.py"]      = web_py
