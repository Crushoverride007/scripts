# VM lab installers. Scoped to these files only, so the rest of the repo is
# left alone. The Vagrantfile refuses to run with CRLF, and a .sh with CRLF
# breaks "curl ... | bash" - so they are always stored and served as LF.
*.sh              text eol=lf
vagrant/**         text eol=lf
# cmd.exe needs CRLF
*.cmd             text eol=crlf
*.ps1             text eol=crlf
